<?xml version="1.0" encoding="UTF-8"?>
<!--
Run the status-light bridge in the background at login.

  1. Edit the two paths below (node, and this plugin directory).
  2. cp launchd/cc.worklouder.herdr-leds.plist ~/Library/LaunchAgents/
  3. launchctl load ~/Library/LaunchAgents/cc.worklouder.herdr-leds.plist

macOS attributes Input Monitoring to the *executable*, so the node binary named
here is what you must grant permission to under
System Settings > Privacy & Security > Input Monitoring.

Logs land in /tmp/herdr-worklouder-micro.{out,err}.log.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>cc.worklouder.herdr-leds</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/CHANGEME/projects/herdr-worklouder-micro/bin/leds.js</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/herdr-worklouder-micro.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/herdr-worklouder-micro.err.log</string>
</dict>
</plist>
